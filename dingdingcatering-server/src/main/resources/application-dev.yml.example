dingding:
  datasource:
    host: localhost
    port: 3306
    database: dingding_catering
    username: root
    password: <你的数据库密码>
  alioss:
    region: cn-beijing
    bucket-name: <你的OSS Bucket名称>
    access-key-id: <你的阿里云AccessKeyId>
    access-key-secret: <你的阿里云AccessKeySecret>
  redis:
    host: localhost
    port: 6379
    password: <你的Redis密码>
    database: 0
  jwt:
    admin-secret-key: <管理端JWT签名密钥，至少32位随机字符串>
    admin-ttl: 7200000
    admin-token-name: token
    user-secret-key: <用户端JWT签名密钥，至少32位随机字符串>
    user-ttl: 7200000
    user-token-name: authentication
  wechat:
    appid: <你的微信小程序AppId>
    secret: <你的微信小程序AppSecret>